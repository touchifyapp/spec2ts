{
  "version": "independent",
  "command": {
    "version": {
      "allowBranch": ["@release/*"],
      "conventionalCommits": true,
      "gitTagVersion": false,
      "push": false,
      "ignoreChanges": [
        "**/*.md",
        "**/LICENSE",
        "**/tests/**"
      ]
    },
    "publish": {
      "registry": "https://registry.npmjs.org/"
    },
    "bootstrap": {
      "hoist": "**"
    }
  },
  "packages": [
    "packages/*"
  ]
}
